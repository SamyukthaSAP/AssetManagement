<mvc:View
    controllerName="admindashboard.controller.ManagerDashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

    <Page id="adminDashboardPage"
    title="Manager Dashboard">
    
        <content>
            <HBox id="kpiContainer"
                justifyContent="SpaceAround"
                wrap="Wrap">

                <GenericTile id="tileTotalAssets"
                header="Total Assets">
                    <tileContent>
                        <TileContent id="tileContentTotal">
                            <content>
                                <NumericContent id="numericTotalAssets"
                                value="{kpi>/totalAssets}"/>
                            </content>
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <GenericTile id="tileAssignedAssets"
                header="Assigned Assets">
                    <tileContent>
                        <TileContent id="TileAssigned">
                            <content>
                                <NumericContent id="numericAssigned"
                                value="{kpi>/assignedAssets}"/>
                            </content>
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <GenericTile id="tileRepairAssets"
                header="In Repair Assets">
                    <tileContent>
                        <TileContent id="tileRepair">
                            <content>
                                <NumericContent id="numericval"
                                 value="{kpi>/repairAssets}"/>
                            </content>
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <GenericTile id="tileRetir" header="Retired">
    <tileContent>
        <TileContent id="tileContentRetire">
            <content>
                <NumericContent
                    id="numericRetire"
                    value="{kpi>/retiredAssets}"/>
            </content>
        </TileContent>
    </tileContent>
</GenericTile>

<GenericTile id="tileArchived" header="Archived Assets">
    <tileContent>
        <TileContent id="tileContentArchived">
            <content>
                <NumericContent
                    id="numericArchived"
                    value="{kpi>/archivedAssets}"/>
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
<GenericTile id="tileEmployee" header="Active Employees">
    <tileContent>
        <TileContent id="tileEmp">
            <content>
                <NumericContent
                    id="numericEmployee"
                    value="{kpi>/employees}"/>
            </content>
        </TileContent>
    </tileContent>
</GenericTile>
            </HBox>
<HBox width="100%" justifyContent="SpaceBetween" renderType="Bare">

    <Panel id="assetStatusPanel" headerText="Asset Status Overview"
           expandable="true" expanded="true" width="49%">
        <viz:VizFrame id="assetStatusChart" vizType="donut"
            width="100%" height="350px"
            uiConfig="{applicationSet:'fiori'}"
            vizProperties="{title: {visible: false}}">
            <!-- dataset and feeds exactly as before -->
            <viz:dataset>
            <viz.data:FlattenedDataset data="{chart>/items}">
                <viz.data:dimensions>
                    <viz.data:DimensionDefinition name="Status" value="{chart>Status}"/>
                </viz.data:dimensions>
                <viz.data:measures>
                    <viz.data:MeasureDefinition name="Count" value="{chart>Count}"/>
                </viz.data:measures>
            </viz.data:FlattenedDataset>
        </viz:dataset>
        <viz:feeds>
            <viz.feeds:FeedItem uid="size" type="Measure" values="Count"/>
            <viz.feeds:FeedItem uid="color" type="Dimension" values="Status"/>
        </viz:feeds>
        </viz:VizFrame>
    </Panel>

    <Panel id="departmentPanel" headerText="Assets by Category"
           expandable="true" expanded="true" width="49%">
        <viz:VizFrame id="departmentChart" vizType="column"
            width="100%" height="350px"
            uiConfig="{applicationSet:'fiori'}"
            vizProperties="{title: {visible: false}}">
            <!-- dataset and feeds exactly as before -->
            <viz:dataset>
            <viz.data:FlattenedDataset data="{deptChart>/items}">
                <viz.data:dimensions>
                    <viz.data:DimensionDefinition name="Category" value="{deptChart>label}"/>
                </viz.data:dimensions>
                <viz.data:measures>
                    <viz.data:MeasureDefinition name="Assets" value="{deptChart>count}"/>
                </viz.data:measures>
            </viz.data:FlattenedDataset>
        </viz:dataset>
        <viz:feeds>
            <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Assets"/>
            <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Category"/>
        </viz:feeds>
        </viz:VizFrame>
    </Panel>

</HBox>
<Panel id="employeePanel" headerText="IT Department Employees"
       expandable="true" expanded="true">
    <Table id="employeeTable" items="{empModel>/items}" growing="true" growingThreshold="10">
        <headerToolbar>
            <OverflowToolbar>
                <Title text="Employees"/>
                <ToolbarSpacer/>
                <SearchField width="15rem" placeholder="Search name..."
                             liveChange=".onEmployeeSearch"/>
            </OverflowToolbar>
        </headerToolbar>
        <columns>
            <Column><Text text="Name"/></Column>
            <Column><Text text="Email"/></Column>
            <Column><Text text="Phone"/></Column>
            <Column><Text text="Location"/></Column>
            <Column><Text text="Status"/></Column>
            <Column><Text text="Action"/></Column>
        </columns>
        <items>
            <ColumnListItem>
                <cells>
                    <Text text="{empModel>full_name}"/>
                    <Text text="{empModel>email}"/>
                    <Text text="{empModel>phone}"/>
                    <Text text="{empModel>location}"/>
                    <ObjectStatus text="{empModel>status}"/>
                    <Button text="Raise Ticket" icon="sap-icon://add" press=".onRaiseTicket"/>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</Panel>
        </content>
<Panel id="reportPanel" headerText="Reports &amp; Export"
       expandable="true" expanded="true">

    <HBox id="reportButtons" alignItems="Center" wrap="Wrap">
        <Button id="Bii" text="Export Report PDF"
                icon="sap-icon://pdf-attachment"
                press=".onExportPDF"
                class="sapUiSmallMarginEnd"/>

        <Button id="hi" text="Download Report"
                icon="sap-icon://download"
                press=".onDownloadReport"
                class="sapUiSmallMarginEnd"/>

        <Button id="ksjhd" text="Email Report"
                icon="sap-icon://email"
                press=".onEmailReport"/>
    </HBox>

</Panel>
    </Page>

</mvc:View>